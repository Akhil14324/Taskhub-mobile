# Copy to .env, fill in, then restart `npx expo start` / rebuild — EXPO_PUBLIC_* values
# are baked into the bundle at build time.

# Backend API (defaults to the Render deployment when empty), e.g.
# https://your-backend.up.railway.app/api
EXPO_PUBLIC_API_URL=
# Only needed if Socket.IO lives on a different host than the API.
EXPO_PUBLIC_SOCKET_URL=

# Google Translate (Telugu for dynamic text)
EXPO_PUBLIC_GOOGLE_TRANSLATE_API_KEY=

# --- Firebase web push (PWA notifications) --------------------------------------
# Firebase console → Project settings → General → Your apps → Web app → config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=taskhub-dd90f.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=taskhub-dd90f
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=taskhub-dd90f.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=285644205703
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Project settings → Cloud Messaging → Web Push certificates → Key pair
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
