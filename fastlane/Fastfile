default_platform(:ios)

platform :ios do
  desc "Build a signed App Store IPA. Set UPLOAD_TO_TESTFLIGHT=true to also upload."
  lane :release do
    keychain_name = "taskhub_ci_keychain"
    keychain_password = ENV["KEYCHAIN_PASSWORD"] || "taskhub-ci"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    import_certificate(
      certificate_path: ENV["P12_PATH"],
      certificate_password: ENV["P12_PASSWORD"] || "",
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )

    install_provisioning_profile(path: ENV["PROFILE_PATH"])

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/TaskHub.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      profile_name: ENV["PROFILE_NAME"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "com.vgrand.taskhub",
      targets: ["TaskHub"]
    )

    if ENV["BUILD_NUMBER"] && !ENV["BUILD_NUMBER"].empty?
      increment_build_number(
        build_number: ENV["BUILD_NUMBER"],
        xcodeproj: "ios/TaskHub.xcodeproj"
      )
    end

    build_app(
      workspace: "ios/TaskHub.xcworkspace",
      scheme: "TaskHub",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ios",
      output_name: "TaskHub.ipa",
      clean: true,
      export_options: {
        method: "app-store",
        teamID: ENV["APPLE_TEAM_ID"],
        signingStyle: "manual",
        provisioningProfiles: {
          "com.vgrand.taskhub" => ENV["PROFILE_NAME"]
        },
        uploadBitcode: false,
        uploadSymbols: true,
        compileBitcode: false
      }
    )

    if ENV["UPLOAD_TO_TESTFLIGHT"] == "true"
      api_key = app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_filepath: ENV["ASC_KEY_PATH"],
        in_house: false
      )
      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true,
        notify_external_testers: false
      )
    end
  end
end
