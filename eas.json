{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "API_URL": "https://vgrand-taskhub-backend.onrender.com/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
