{
  "expo": {
    "name": "TaskHub",
    "slug": "vgrandtaskhub",
    "owner": "vgrandtaskhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vgrand.taskhub",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.vgrand.taskhub",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4f46e5"
      }
    },
    "extra": {
      "eas": {
        "projectId": "6ff08814-1fa6-4d0a-8a30-57eef8ed87d8"
      }
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableProguardInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#4f46e5",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-notifications",
      "expo-status-bar"
    ]
  }
}
