    "@react-navigation/native-stack": "^6.9.17",
    "axios": "^1.6.3",
    "babel-preset-expo": "~56.0.0",
    "expo": "^56.0.19",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.22",
