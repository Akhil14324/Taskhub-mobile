{
  "name": "taskhub-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "build:android": "eas build -p android --profile preview",
    "build:ios": "eas build -p ios --profile preview",
    "build:android:prod": "eas build -p android --profile production",
    "build:ios:prod": "eas build -p ios --profile production",
    "build:all:prod": "eas build -p all --profile production",
    "submit:android": "eas submit -p android",
    "submit:ios": "eas submit -p ios",
    "submit:all": "eas submit -p all --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "axios": "^1.6.3",
    "expo": "^56.0.19",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.22",
    "expo-build-properties": "~56.0.25",
    "expo-dev-client": "~56.0.24",
    "expo-document-picker": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-image-picker": "~56.0.23",
    "expo-notifications": "~56.0.23",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "react-native-dotenv": "^3.4.12"
  },
  "engines": {
    "node": ">=18"
  }
}
